<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007-create-resource-health-events" author="stimur1709">
        <createTable tableName="resource_health_events">
            <column name="id" type="BIGINT" autoIncrement="true" generationType="ALWAYS">
                <constraints nullable="false" primaryKey="true" primaryKeyName="resource_health_events_pkey"/>
            </column>
            <column name="resource_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="from_status" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="to_status" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="resource_health_events" baseColumnNames="resource_id"
                                 constraintName="resource_health_events_resource_fk" referencedTableName="resources"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <sql dbms="postgresql">
            ALTER TABLE resource_health_events ADD CONSTRAINT resource_health_events_transition_check
                CHECK (
                    from_status IN ('UNKNOWN', 'UP', 'DEGRADED', 'DOWN')
                    AND to_status IN ('UNKNOWN', 'UP', 'DEGRADED', 'DOWN')
                    AND from_status &lt;&gt; to_status
                );
            CREATE INDEX resource_health_events_resource_changed_at_idx
                ON resource_health_events (resource_id, changed_at DESC);
        </sql>

        <rollback>
            <dropTable tableName="resource_health_events"/>
        </rollback>
    </changeSet>
</databaseChangeLog>

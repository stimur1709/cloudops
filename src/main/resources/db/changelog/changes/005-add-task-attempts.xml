<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-add-task-attempts" author="stimur1709">
        <addColumn tableName="tasks">
            <column name="attempt_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_attempt_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>

        <sql dbms="postgresql">
            ALTER TABLE tasks
                ADD CONSTRAINT tasks_attempt_count_check CHECK (attempt_count &gt;= 0);
        </sql>

        <rollback>
            <dropColumn tableName="tasks" columnName="last_attempt_at"/>
            <dropColumn tableName="tasks" columnName="attempt_count"/>
        </rollback>
    </changeSet>
</databaseChangeLog>

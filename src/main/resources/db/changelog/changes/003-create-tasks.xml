<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-tasks" author="stimur1709">
        <createTable tableName="tasks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="tasks_pkey"/>
            </column>
            <column name="organization_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="resource_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="result" type="JSONB"/>
            <column name="error_code" type="VARCHAR(30)"/>
            <column name="error_message" type="VARCHAR(255)"/>
            <column name="attempt_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_attempt_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="tasks" baseColumnNames="organization_id"
                                 constraintName="tasks_organization_fk" referencedTableName="organizations"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="tasks" baseColumnNames="resource_id"
                                 constraintName="tasks_resource_fk" referencedTableName="resources"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="tasks" baseColumnNames="created_by"
                                 constraintName="tasks_created_by_fk" referencedTableName="users"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>

        <createIndex tableName="tasks" indexName="tasks_organization_idx">
            <column name="organization_id"/>
        </createIndex>
        <createIndex tableName="tasks" indexName="tasks_resource_idx">
            <column name="resource_id"/>
        </createIndex>
        <createIndex tableName="tasks" indexName="tasks_created_by_idx">
            <column name="created_by"/>
        </createIndex>

        <sql dbms="postgresql">
            ALTER TABLE tasks
                ADD CONSTRAINT tasks_type_check CHECK (type IN ('HTTP_CHECK'));
            ALTER TABLE tasks
                ADD CONSTRAINT tasks_status_check
                    CHECK (status IN ('PENDING', 'RUNNING', 'COMPLETED', 'FAILED'));
            ALTER TABLE tasks
                ADD CONSTRAINT tasks_completion_check CHECK (
                    (status = 'PENDING' AND started_at IS NULL AND completed_at IS NULL)
                    OR (status = 'RUNNING' AND started_at IS NOT NULL AND completed_at IS NULL)
                    OR (status IN ('COMPLETED', 'FAILED') AND started_at IS NOT NULL AND completed_at IS NOT NULL)
                );
            ALTER TABLE tasks
                ADD CONSTRAINT tasks_attempt_count_check CHECK (attempt_count &gt;= 0);
        </sql>

        <rollback>
            <dropTable tableName="tasks"/>
        </rollback>
    </changeSet>
</databaseChangeLog>

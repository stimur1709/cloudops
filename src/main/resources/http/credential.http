# Before running: fill sshUsername and sshPassword in http-client.private.env.json.
# SSH_CHECK uses strict host key verification, so the application known_hosts file must trust the resource host key.

### Create SSH username/password credential
POST http://localhost:8080/api/organizations/1/credentials
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "{{sshCredentialName}}",
  "type": "USERNAME_PASSWORD",
  "username": "{{sshUsername}}",
  "password": "{{sshPassword}}"
}

> {%
    client.global.set("sshCredentialId", response.body.id);
%}

### Bind credential to the resource created in resource.http
PUT http://localhost:8080/api/resources/{{networkProbeResourceId}}/credentials/SSH
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "credentialId": {{sshCredentialId}}
}

### List resource credential bindings
GET http://localhost:8080/api/resources/{{networkProbeResourceId}}/credentials
Authorization: Bearer {{accessToken}}

### Find the auto-provisioned SSH_CHECK monitor
GET http://localhost:8080/api/resources/{{networkProbeResourceId}}/monitors
Authorization: Bearer {{accessToken}}

> {%
    const sshMonitor = response.body.find(monitor => monitor.type === "SSH_CHECK");
    if (!sshMonitor) {
        throw new Error("SSH_CHECK monitor was not provisioned");
    }
    client.global.set("sshMonitorId", sshMonitor.id);
%}

### Request SSH_CHECK execution
POST http://localhost:8080/api/monitors/{{sshMonitorId}}/run
Authorization: Bearer {{accessToken}}

### Read SSH_CHECK result after scheduler execution
GET http://localhost:8080/api/resources/{{networkProbeResourceId}}/monitors
Authorization: Bearer {{accessToken}}

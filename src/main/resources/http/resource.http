### Create resource
POST http://localhost:8080/api/resources
Content-Type: application/json

{
  "name": "router-01",
  "type": "NETWORK_DEVICE",
  "status": "ACTIVE",
  "organizationId": 1,
  "config": {
    "host": "10.0.0.1",
    "managementPort": 22
  }
}

### Get resource
GET http://localhost:8080/api/resources/1

### Search resources
POST http://localhost:8080/api/resources/search
Content-Type: application/json

{
  "start": 0,
  "size": 20,
  "filter": {
    "operator": "AND",
    "conditions": [
      {
        "field": "name",
        "operation": "EQ",
        "value": "router-01"
      }
    ]
  },
  "sort": [
    {
      "field": "createdAt",
      "order": "DESC"
    }
  ],
  "getTotal": true
}

### Update resource
PUT http://localhost:8080/api/resources/1
Content-Type: application/json

{
  "name": "router-01",
  "type": "NETWORK_DEVICE",
  "status": "INACTIVE",
  "organizationId": 1,
  "config": {
    "host": "10.0.0.1",
    "managementPort": 2222
  }
}

### Delete resource
DELETE http://localhost:8080/api/resources/1

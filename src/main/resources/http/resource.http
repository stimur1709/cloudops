### Search resources
POST http://localhost:8080/api/resources/search
Content-Type: application/json

{
  "start": 0,
  "size": 20,
  "filter": {
    "operator": "AND",
    "conditions": [
      {
        "field": "id",
        "operation": "EQ",
        "value": "1"
      }
    ]
  },
  "sort": [
    {
      "field": "createdAt",
      "order": "DESC"
    }
  ],
  "getTotal": true
}


@baseUrl = http://localhost:8080
@resourceId = 1

### Create monitor and save its ID
POST {{baseUrl}}/api/resources/{{resourceId}}/monitors
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "HTTP_CHECK",
  "intervalSeconds": 30,
  "enabled": true,
  "storageMode": "HISTORY",
  "retentionDays": 30,
  "failureThreshold": 3,
  "recoveryThreshold": 2
}

> {%
    client.global.set("monitorId", response.body.id);
%}

### List resource monitors with current health
GET {{baseUrl}}/api/resources/{{resourceId}}/monitors
Authorization: Bearer {{accessToken}}

### Update monitor settings and health thresholds
PUT {{baseUrl}}/api/monitors/{{monitorId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "intervalSeconds": 60,
  "enabled": true,
  "storageMode": "HISTORY",
  "retentionDays": 30,
  "failureThreshold": 4,
  "recoveryThreshold": 3
}

### Search monitor result history
POST {{baseUrl}}/api/monitors/{{monitorId}}/results/search
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "start": 0,
  "size": 20,
  "sort": [
    {
      "field": "checkedAt",
      "order": "DESC"
    }
  ],
  "getTotal": true
}

### Disable monitor without changing its health
PUT {{baseUrl}}/api/monitors/{{monitorId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "intervalSeconds": 60,
  "enabled": false,
  "storageMode": "HISTORY",
  "retentionDays": 30,
  "failureThreshold": 4,
  "recoveryThreshold": 3
}

### Delete monitor
DELETE {{baseUrl}}/api/monitors/{{monitorId}}
Authorization: Bearer {{accessToken}}

@baseUrl = http://localhost:8080
@organizationId = 1

### Get effective monitoring settings for every organization probe
GET {{baseUrl}}/api/organizations/{{organizationId}}/monitoring-settings
Authorization: Bearer {{accessToken}}

### Store HTTP_CHECK history for the organization
PUT {{baseUrl}}/api/organizations/{{organizationId}}/monitoring-settings/HTTP_CHECK
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "enabled": true,
  "intervalSeconds": 60,
  "failureThreshold": 3,
  "recoveryThreshold": 2,
  "storageMode": "HISTORY",
  "retentionDays": 30,
  "timeoutMs": 5000
}


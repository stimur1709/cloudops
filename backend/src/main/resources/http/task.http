@baseUrl = http://localhost:8080
@taskId = 1

### Run a command through the asynchronous Task pipeline
POST {{baseUrl}}/api/resources/1/tasks
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"type":"RUN_COMMAND","parameters":{"command":"uname -a"}}

### Get current task state/result
GET {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}

### Search existing tasks
POST {{baseUrl}}/api/tasks/search
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "start": 0,
  "size": 20,
  "sort": [{"field": "createdAt", "order": "DESC"}],
  "getTotal": true
}

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="011-create-credentials" author="stimur1709">
        <createTable tableName="credentials">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="credentials_pkey"/>
            </column>
            <column name="organization_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)"/>
            <column name="secret_encrypted" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="credentials" baseColumnNames="organization_id"
                                 referencedTableName="organizations" referencedColumnNames="id"
                                 constraintName="credentials_organization_fk" onDelete="CASCADE"/>

        <addUniqueConstraint tableName="credentials" columnNames="organization_id, name"
                             constraintName="credentials_organization_name_key"/>

        <createIndex tableName="credentials" indexName="credentials_organization_idx">
            <column name="organization_id"/>
        </createIndex>

        <createIndex tableName="credentials" indexName="credentials_type_idx">
            <column name="type"/>
        </createIndex>

        <createTable tableName="resource_credentials">
            <column name="resource_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="credential_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="purpose" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="resource_credentials" columnNames="resource_id, purpose"
                       constraintName="resource_credentials_pkey"/>

        <addForeignKeyConstraint baseTableName="resource_credentials" baseColumnNames="resource_id"
                                 referencedTableName="resources" referencedColumnNames="id"
                                 constraintName="resource_credentials_resource_fk" onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="resource_credentials" baseColumnNames="credential_id"
                                 referencedTableName="credentials" referencedColumnNames="id"
                                 constraintName="resource_credentials_credential_fk" onDelete="RESTRICT"/>

        <createIndex tableName="resource_credentials" indexName="resource_credentials_credential_idx">
            <column name="credential_id"/>
        </createIndex>

        <sql dbms="postgresql">
            ALTER TABLE credentials
                ADD CONSTRAINT credentials_type_check
                    CHECK (type IN ('USERNAME_PASSWORD', 'SSH_PRIVATE_KEY'));
            ALTER TABLE resource_credentials
                ADD CONSTRAINT resource_credentials_purpose_check
                    CHECK (purpose IN ('SSH', 'DATABASE'));
        </sql>
        <rollback>
            <dropTable tableName="resource_credentials"/>
            <dropTable tableName="credentials"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
